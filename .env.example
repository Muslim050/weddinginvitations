# Контакты — без них форма заявки и телефон никуда не ведут.
# Telegram: только username, без @ и без ссылки
NEXT_PUBLIC_TELEGRAM=
# Телефон в международном формате, он же используется для WhatsApp
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_EMAIL=
# Имя мастера — подписывает страницу живым человеком
NEXT_PUBLIC_OWNER_NAME=

# Адрес самого лендинга: нужен для метаданных и og:image
NEXT_PUBLIC_SITE_URL=

# Публичные адреса демо-шаблонов. Пока пусто — кнопки «Смотреть демо»
# показывают, что демо готовится, вместо ссылки в никуда.
NEXT_PUBLIC_DEMO_CHINOR=
NEXT_PUBLIC_DEMO_NUR=
